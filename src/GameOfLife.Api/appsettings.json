{
  "GameOfLife": {
    "MaxRows": 256,
    "MaxColumns": 256,
    "MaxGenerations": 1000,
    "MaxConcurrentSimulations": 8,
    "RequestTimeoutSeconds": 10
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*"
}
