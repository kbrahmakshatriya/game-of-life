<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP API: endpoints, validation, error responses and storage, around the rules in GameOfLife.Core. -->
  <PropertyGroup>
    <!-- The XML comments on the request and response types become field descriptions in the OpenAPI document.
         Only those types need comments, so a missing one is not a warning here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameOfLife.Core\GameOfLife.Core.csproj" />
  </ItemGroup>

</Project>
